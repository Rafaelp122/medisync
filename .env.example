# MediSync Express — Template de Variáveis de Ambiente de Desenvolvimento Local
# Copie este arquivo para .env: cp .env.example .env

# --- Aplicação Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars

# --- Banco de Dados Relacional (PostgreSQL 17) ---
POSTGRES_USER=medisync
POSTGRES_PASSWORD=medisync
POSTGRES_DB=medisync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medisync:medisync@localhost:5432/medisync

# --- Cache, Fila em Memória e Locks (Valkey 8.0) ---
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_URL=valkey://localhost:6379/0

# --- Servidor de Mídia WebRTC (LiveKit SFU) ---
LIVEKIT_HOST=localhost
LIVEKIT_PORT=7880
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Armazenamento de Objetos S3-Compatível (MinIO) ---
MINIO_ROOT_USER=medisync
MINIO_ROOT_PASSWORD=medisync123
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_DEFAULT_BUCKET=medisync-docs
MINIO_USE_SSL=false
